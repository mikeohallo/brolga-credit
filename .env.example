# Brolga Credit — Zepto configuration
# Copy to .env.local (never commit .env.local).

# Personal Access Token from go.sandbox.zeptopayments.com → your name → Your applications
ZEPTO_TOKEN=

# sandbox (default when a token is set) or mock (in-memory stand-in, no network)
ZEPTO_MODE=sandbox

# Mandatory for this account; 409 "API Version Below Minimum" without it
ZEPTO_API_VERSION=20260101

ZEPTO_BASE_URL=https://api.sandbox.zeptopayments.com

# Mock only: set to 0 to pretend there is no float account (Direct Entry only)
MOCK_FLOAT=1
